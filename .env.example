# Copy to .env (`make up` does it for you). These are DEMO values for a local machine only:
# change every password before exposing any port beyond localhost. .env is git-ignored.
PORTAL_USERNAME=demo
PORTAL_PASSWORD=demo-change-me
GRAFANA_ADMIN_PASSWORD=demo-change-me
POSTGRES_USER=admin
POSTGRES_PASSWORD=demo-change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=demo-change-me
# Fault injection endpoints of the Prediction API (used by the Streamlit scenarios). Never enable in production.
CHAOS_ENABLED=true
# Empty: embedded tools use the host typed in the browser, so localhost and <vm-ip>:8501 both work.
# Set it only to force one address (for instance a DNS name behind a proxy).
PUBLIC_HOST=
DEMO_ROWS=5000
LOKI_PORT=3101
