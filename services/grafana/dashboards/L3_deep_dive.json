    {
      "id": 15,
      "title": "\ud83d\udea8 Active Alerts in Prometheus",
      "type": "row",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "collapsed": false
    },
    {
      "id": 16,
      "title": "Alert List",
      "type": "alertlist",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "options": {
        "show": "all",
        "sortOrder": 1,
        "stateFilter": {
          "firing": true,
          "pending": true,
